# Browser-facing API path. Local geliştirmede /api kullanın (Next.js rewrite proxy).
NEXT_PUBLIC_API_URL=/api

# Server-only backend origin for proxy.ts and next.config rewrites
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# next.config.ts içinde experimental.proxyTimeout=300000 (5 dk) ayarlıdır.
# Uzun analizler için Next.js dev sunucusunu yeniden başlatın.
